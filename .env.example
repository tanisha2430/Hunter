# --- AI providers ---
# Required: Anthropic is the default provider for all agents.
ANTHROPIC_API_KEY=

# Optional: enables OpenAI/Google as pluggable AIProvider implementations.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Optional: embeddings provider (Anthropic has no native embeddings endpoint).
VOYAGE_API_KEY=

# --- Database (Supabase Postgres) ---
# Pooled connection (pgbouncer, port 6543) — used at runtime by Prisma Client.
DATABASE_URL=
# Direct connection (port 5432) — used for Prisma migrations.
DIRECT_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser, never log.
SUPABASE_SERVICE_ROLE_KEY=

# --- Security ---
# 32-byte key, hex-encoded (64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Outreach (optional, off by default) ---
# "none" | "hunter" — third-party contact-enrichment API, requires your own key.
EMAIL_DISCOVERY_PROVIDER=none
HUNTER_API_KEY=

# --- Gmail OAuth (optional — enables real outreach sending + inbox status scanning) ---
# From console.cloud.google.com: enable the Gmail API, then create an OAuth
# 2.0 Client ID (Web application) with this exact redirect URI registered:
#   http://localhost:3000/api/auth/gmail/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# --- Adzuna job search API (optional — real public multi-company job aggregator) ---
# From developer.adzuna.com dashboard.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Daily unattended batch (optional — refresh + score + prepare on a schedule) ---
# Required for apps/web/app/api/internal/daily-batch to accept requests; generate
# with `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
DAILY_BATCH_SECRET=
DAILY_SCORE_CAP=40
DAILY_MIN_SCORE=85
